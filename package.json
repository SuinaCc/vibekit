{
  "name": "aero",
  "version": "1.0.0",
  "description": "LocalVibeBox - 本地离线插件化效率工具箱",
  "main": "./out/main/index.js",
  "private": true,
  "author": "Aero",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^13.0.0",
