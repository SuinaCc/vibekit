    "pdfjs-dist": "^5.4.296",
    "qrcode": "^1.5.4",
    "zod": "^3.23.0"
  },
  "scripts": {
    "dev": "chcp 65001 >nul 2>&1 && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prepackage:win": "electron-vite build",
    "package:win": "electron-builder --win",
    "prepackage:mac": "electron-vite build",
    "package:mac": "electron-builder --mac",
    "prepackage:linux": "electron-vite build",
